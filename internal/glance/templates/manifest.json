{
    "name": "{{ .App.Config.Branding.AppName }}",
    "short_name": "{{ .App.Config.Branding.AppName }}",
    "description": "Personal dashboard and monitoring application",
    "display": "standalone",
    "background_color": "{{ .App.Config.Branding.AppBackgroundColor }}",
    "theme_color": "{{ .App.Config.Branding.AppBackgroundColor }}",
    "scope": "/",
    "start_url": "/",
    "orientation": "any",
    "icons": [
        {
            "src": "{{ .App.Config.Branding.AppIconURL }}",
            "type": "image/png",
            "sizes": "192x192",
            "purpose": "any"
        },
        {
            "src": "{{ .App.Config.Branding.AppIconURL }}",
            "type": "image/png",
            "sizes": "512x512",
            "purpose": "any maskable"
        }
    ]
}
